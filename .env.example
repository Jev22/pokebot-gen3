# Copy this file to `.env` and edit the values, then `docker compose up -d --build`.

# --- Required on first run --------------------------------------------------
# File name of your ROM as placed in ./roms/ (e.g. "Emerald.gba").
# Only used to create the profile the first time; ignored once it exists.
POKEBOT_ROM=

# --- Profile & bot behaviour ------------------------------------------------
# Name of the profile to run (created automatically from POKEBOT_ROM if missing).
POKEBOT_PROFILE=default

# Bot mode to start in. "Manual" just idles so you can drive it from the web UI.
# Other modes depend on the game/location (e.g. Spin, Fishing, Sweet Scent,
# Starters, ...). See the wiki: wiki/pages/Pokemon By Bot Mode.md
POKEBOT_BOT_MODE=Manual

# --- Web dashboard ----------------------------------------------------------
# Host interface the dashboard is published on. 127.0.0.1 = local only (safest).
# Set to your Tailscale IP (100.x.y.z) to reach it over your tailnet, or 0.0.0.0
# ONLY if the port is already protected by a firewall/VPN — the bot has no auth.
POKEBOT_BIND=127.0.0.1
POKEBOT_WEB_PORT=8888

# Set to 0 to run without the web UI at all.
POKEBOT_ENABLE_WEB=1

# --- Advanced ---------------------------------------------------------------
# Enable emulator audio (needs an audio device on the host; usually leave off).
POKEBOT_AUDIO=0

# Turn off video rendering to save CPU (disables the live view in the web UI).
POKEBOT_NO_VIDEO=0

# Extra raw arguments appended to `pokebot.py` (advanced use).
POKEBOT_EXTRA_ARGS=
